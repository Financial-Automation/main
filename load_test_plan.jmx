            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>

        <!-- 18. Controlled Safe Write Request: Create Customer -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/customers (Create Test Customer)" enabled="true">
          <stringProp name="HTTPSampler.path">/api/customers</stringProp>
